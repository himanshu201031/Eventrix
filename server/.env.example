# Copy this file to `.env` and fill in real values.
#   cp .env.example .env

# MongoDB connection string (required)
MONGO_URL=mongodb://127.0.0.1:27017/eventrix

# JWT signing secret — use a long random string in production
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Server port (defaults to 5000)
PORT=5000

# Comma-separated allowlist of frontend origins in production.
# Leave unset in development to allow all origins.
# CORS_ORIGINS=https://eventrix.example.com,https://admin.eventrix.example.com

# Log level: silent | error | warn | info | debug (defaults to info)
LOG_LEVEL=info

# Email provider credentials used by utils/email.js
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=Eventrix <no-reply@eventrix.example.com>

# SMTP connection settings (defaults to Gmail over SSL/465)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# For port 587 (STARTTLS): SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
